# Copie para .dev.vars e ajuste. NÃO comite .dev.vars.
PAINEL_USER=admin
PAINEL_SENHA=troque-esta-senha
# Opcional: chave própria do JWT de sessão (recomendada em produção).
SESSION_SECRET=troque-este-segredo-de-sessao
WEBHOOK_TOKEN=troque-este-token
CRON_TOKEN=troque-este-token

# Login via Cloudflare Access (produção): mude para 1 depois de configurar o Access.
TRUST_ACCESS=0

# Login por certificado via proxy/mTLS (opcional).
AUTH_CERT=0
PROXY_SECRET=troque-este-segredo
# CERT_HEADER=X-Client-Cert
# URL do endpoint mTLS que abre o seletor de certificados do sistema.
# Se vazio, o botão usa /cert-login no mesmo domínio.
# CERT_LOGIN_URL=https://painel.seudominio.com/cert-login

TZ=America/Sao_Paulo
